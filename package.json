{
  "name": "nexura-dj-studio",
  "productName": "Nexura DJ Studio",
  "version": "1.0.0-rc.3",
  "description": "Nexura DJ Studio — software DJ de NexuraIA compatible con controladoras MIDI y listas de YouTube",
  "main": "main.js",
  "author": "NexuraIA <contacto@nexuraia.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "legal": "node tools/legal.js",
    "dist": "node tools/legal.js && electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "web": "node tools/serve.js",
    "beta": "node tools/legal.js && electron-builder --win nsis --x64 && node tools/package-beta.js",
    "release": "node tools/legal.js && electron-builder --win nsis --x64 --publish always",
    "store:icons": "electron tools/store-icons.cjs",
    "store": "node tools/legal.js && node tools/store.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexuraia.djstudio",
    "productName": "Nexura DJ Studio",
    "copyright": "© NexuraIA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.local.json",
      "main/**/*",
      "src/**/*",
      "build/icon.png",
      "!src/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Nexura-DJ-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexura DJ Studio",
      "uninstallDisplayName": "Nexura DJ Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "license": "src/legal/LICENCIA.txt"
    },
    "extraResources": [
      {
        "from": "tools/stems",
        "to": "stems",
        "filter": [
          "pyproject.toml",
          "separate.py"
        ]
      },
      {
        "from": "src/legal",
        "to": "legal",
        "filter": [
          "*.txt"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mcontrerasdevpro",
        "repo": "nexura-dj-studio",
        "releaseType": "draft"
      }
    ],
    "appx": {
      "displayName": "Nexura DJ Studio",
      "publisherDisplayName": "NexuraIA",
      "applicationId": "NexuraDJStudio",
      "backgroundColor": "#070b14",
      "languages": [
        "es-ES"
      ],
      "showNameOnTiles": true,
      "artifactName": "Nexura-DJ-Studio-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "metaflac-js": "^1.1.0",
    "node-id3": "^0.2.9"
  }
}
